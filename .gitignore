# macOS
.DS_Store

# Python
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Node
node_modules/
dist/

# MkDocs build output
site/

# Secrets / env
.env
.env.*
# …but the committed, secret-free template is the one exception.
!.env.example

# Editor
.idea/

# BYO workspaces (Milestone 18, ADR 0028): local snapshots of foreign data —
# fetched by `tessera connect`, read by `tessera ask`, NEVER committed.
var/

# Personal launch/application material — kept LOCAL, never published (spec 0124
# lesson; includes person-level outreach data such as targets.csv). Everything
# under launch/ is local by default; only launch/README.md and
# launch/registries/ (the MCP-registry submission, needed by tests) stay
# tracked. The allowlist form exists so a new local subdirectory can never
# leak by omission.
launch/*
!launch/README.md
!launch/registries/
!launch/registries/**
