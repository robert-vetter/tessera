6"]]},"source":"salt_synthetic/I_SalesDocumentItem.csv"},"text":"Item 10 of sales document 0000500081: Maintenance service contract (material MAT-3933), quantity 11, net EUR 16,500.00."},{"id":"I_SalesDocumentItem:0000500081-20","origin":{"ingested_at":"2026-06-05","locator":{"kind":"table-row","parts":[["table","I_SalesDocumentItem"],["row","167"]]},"source":"salt_synthetic/I_SalesDocumentItem.csv"},"text":"Item 20 of sales document 0000500081: Pallet racking unit (material MAT-8231), quantity 3, net EUR 16,500.00."},{"id":"I_SalesDocumentItem:0000500082-10","origin":{"ingested_at":"2026-06-05","locator":{"kind":"table-row","parts":[["table","I_SalesDocumentItem"],["row","168"]]},"source":"salt_synthetic/I_SalesDocumentItem.csv"},"text":"Item 10 of sales document 0000500082: Conveyor belt segment (material MAT-9787), quantity 4, net EUR 500.00."},{"id":"I_SalesDocumentItem:0000500082-20","origin":{"ingested_at":"2026-06-05","locator":{"kind":"table-row","parts":[["table","I_SalesDocumentItem"],["row","169"]]},"source":"salt_synthetic/I_SalesDocumentItem.csv"},"text":"Item 20 of sales document 0000500082: Steel shelving kit (material MAT-3012), quantity 8, net EUR 17,000.00."},{"id":"I_SalesDocumentItem:0000500900-10","origin":{"ingested_at":"2026-06-05","locator":{"kind":"table-row","parts":[["table","I_SalesDocumentItem"],["row","170"]]},"source":"salt_synthetic/I_SalesDocumentItem.csv"},"text":"Item 10 of sales document 0000500900: Pallet racking unit (material MAT-8231), quantity 10, net EUR 15,000.00."},{"id":"I_SalesDocumentItem:0000500901-10","origin":{"ingested_at":"2026-06-05","locator":{"kind":"table-row","parts":[["table","I_SalesDocumentItem"],["row","171"]]},"source":"salt_synthetic/I_SalesDocumentItem.csv"},"text":"Item 10 of sales document 0000500901: Packaging line upgrade (material MAT-2039), quantity 1, net USD 18,000.00."},{"id":"bayerische_stahlwerke_terms:chunk1","origin":{"ingested_at":"2026-06-05","locator":{"kind":"doc-span","parts":[["lines","1-4"],["chunk","1"]]},"source":"business_docs/bayerische_stahlwerke_terms.md"},"text":"# Supply Agreement — Terms and Conditions\n\nSupplier: Tessera Demonstrations Ltd. Customer: Bayerische Stahlwerke AG, a steel\nmanufacturer based in München, Germany."},{"id":"bayerische_stahlwerke_terms:chunk2","origin":{"ingested_at":"2026-06-05","locator":{"kind":"doc-span","parts":[["lines","6-10"],["chunk","2"]]},"source":"business_docs/bayerische_stahlwerke_terms.md"},"text":"## 1. Volume discount\n\nThe Customer qualifies for a tiered volume discount: 5% on annual order value\nabove EUR 25,000, rising to 8% above EUR 50,000. Discounts are reconciled at the\nend of each calendar year."},{"id":"bayerische_stahlwerke_terms:chunk3","origin":{"ingested_at":"2026-06-05","locator":{"kind":"doc-span","parts":[["lines","12-16"],["chunk","3"]]},"source":"business_docs/bayerische_stahlwerke_terms.md"},"text":"## 2. Delivery conditions\n\nDeliveries to the Customer's München works require advance scheduling of at least\nfive (5) working days, owing to on-site crane availability. Incoterms are DAP\n(Delivered At Place) unless otherwise agreed in writing per order."},{"id":"bayerische_stahlwerke_terms:chunk4","origin":{"ingested_at":"2026-06-05","locator":{"kind":"doc-span","parts":[["lines","18-21"],["chunk","4"]]},"source":"business_docs/bayerische_stahlwerke_terms.md"},"text":"## 3. Quality and inspection\n\nAll steel components are subject to incoming inspection. Non-conforming goods may\nbe rejected within ten (10) working days of delivery without penalty."},{"id":"lumiere_energie_letter:chunk1","origin":{"ingested_at":"2026-06-05","locator":{"kind":"doc-span","parts":[["lines","1-5"],["chunk","1"]]},"source":"business_docs/lumiere_energie_letter.md"},"text":"# Letter of Agreement — Billing Arrangement\n\nTo: Lumière Énergie\nFrom: Tessera Demonstrations Ltd\nSubject: Confirmation of special billing condition"},{"id":"lumiere_energie_letter:chunk2","origin":{"ingested_at":"2026-06-05","locator":{"kind":"doc-span","parts":[["lines","7-7"],["chunk","2"]]},"source":"business_docs/lumiere_energie_letter.md"},"text":"Dear Sir or Madam,"},{"id":"lumiere_energie_letter:chunk3","origin":{"ingested_at":"2026-06-05","locator":{"kind":"doc-span","parts":[["lines","9-12"],["chunk","3"]]},"source":"business_docs/lumiere_energie_letter.md"},"text":"We write to confirm the special condition agreed for your account. By exception\nto our standard monthly cycle, invoices to Lumière Énergie will be issued\nquarterly, in arrears, consolidating all orders placed within each calendar\nquarter into a single statement."},{"id":"lumiere_energie_letter:chunk4","origin":{"ingested_at":"2026-06-05","locator":{"kind":"doc-span","parts":[["lines","14-17"],["chunk","4"]]},"source":"business_docs/lumiere_energie_letter.md"},"text":"This arrangement is granted for the duration of the current supply relationship\nand may be revisited at annual review. A force-majeure clause applies: obligations\nare suspended for events beyond reasonable control, including grid-level energy\ndisruptions."},{"id":"lumiere_energie_letter:chunk5","origin":{"ingested_at":"2026-06-05","locator":{"kind":"doc-span","parts":[["lines","19-20"],["chunk","5"]]},"source":"business_docs/lumiere_energie_letter.md"},"text":"Kind regards,\nAccounts Team"},{"id":"mueller_logistik_amendment:chunk1","origin":{"ingested_at":"2026-06-05","locator":{"kind":"doc-span","parts":[["lines","1-4"],["chunk","1"]]},"source":"business_docs/mueller_logistik_amendment.md"},"text":"# Amendment No. 2 to the Master Service Agreement\n\nThis Amendment No. 2 (the \"Amendment\") modifies the Master Service Agreement\nbetween Tessera Demonstrations Ltd and Müller Logistik GmbH."},{"id":"mueller_logistik_amendment:chunk2","origin":{"ingested_at":"2026-06-05","locator":{"kind":"doc-span","parts":[["lines","6-10"],["chunk","2"]]},"source":"business_docs/mueller_logistik_amendment.md"},"text":"## 1. Change of renewal date\n\nSection 2 of the Agreement is amended as follows: the Agreement auto-renews\nannually on 1 February, aligning the contract year with the customer's fiscal\nyear. The sixty (60) days notice period for termination remains unchanged."},{"id":"mueller_logistik_amendment:chunk3","origin":{"ingested_at":"2026-06-05","locator":{"kind":"doc-span","parts":[["lines","12-16"],["chunk","3"]]},"source":"business_docs/mueller_logistik_amendment.md"},"text":"## 2. No other changes\n\nAll other terms of the Agreement remain in full force and effect. In the event\nof inconsistency between this Amendment and the Agreement, the parties'\nintent shall be determined by their authorized representatives."},{"id":"mueller_logistik_amendment:chunk4","origin":{"ingested_at":"2026-06-05","locator":{"kind":"doc-span","parts":[["lines","18-18"],["chunk","4"]]},"source":"business_docs/mueller_logistik_amendment.md"},"text":"Signed for Müller Logistik GmbH and Tessera Demonstrations Ltd."},{"id":"mueller_logistik_msa:chunk1","origin":{"ingested_at":"2026-06-05","locator":{"kind":"doc-span","parts":[["lines","1-5"],["chunk","1"]]},"source":"business_docs/mueller_logistik_msa.md"},"text":"# Master Service Agreement\n\nThis Master Service Agreement (\"Agreement\") is entered into between Tessera\nDemonstrations Ltd (\"Provider\") and Mueller Logistik Gmbh (\"Customer\"), a\nlogistics company registered in Hamburg, Germany."},{"id":"mueller_logistik_msa:chunk2","origin":{"ingested_at":"2026-06-05","locator":{"kind":"doc-span","parts":[["lines","7-10"],["chunk","2"]]},"source":"business_docs/mueller_logistik_msa.md"},"text":"## 1. Scope\n\nThe Provider shall supply warehouse-handling equipment and related maintenance\nservices to the Customer across its German distribution sites."},{"id":"mueller_logistik_msa:chunk3","origin":{"ingested_at":"2026-06-05","locator":{"kind":"doc-span","parts":[["lines","12-16"],["chunk","3"]]},"source":"business_docs/mueller_logistik_msa.md"},"text":"## 2. Term and renewal\n\nThe initial term of this Agreement is twelve (12) months. Thereafter the\nAgreement auto-renews annually on 1 August unless either party gives at least\nsixty (60) days written notice of termination prior to the renewal date."},{"id":"mueller_logistik_msa:chunk4","origin":{"ingested_at":"2026-06-05","locator":{"kind":"doc-span","parts":[["lines","18-21"],["chunk","4"]]},"source":"business_docs/mueller_logistik_msa.md"},"text":"## 3. Payment terms\n\nAll invoices are payable net 30 days from the invoice date. Late payment accrues\ninterest at 4% per annum above the statutory base rate."},{"id":"mueller_logistik_msa:chunk5","origin":{"ingested_at":"2026-06-05","locator":{"kind":"doc-span","parts":[["lines","23-26"],["chunk","5"]]},"source":"business_docs/mueller_logistik_msa.md"},"text":"## 4. Special conditions\n\nThe Customer is entitled to priority next-day dispatch on spare-part orders, a\ncondition negotiated in recognition of its time-critical operations."}]},"kind":"full-graph-snapshot"},"format":{"major":1,"minor":0,"name":"tessera-trust-bundle"},"integrity":{"canonicalization":"tessera-canonical-json-1","leaves":{"action":"sha256:74234e98afe7498fb5daf1f36ac2d78acc339464f950703b8c019892f982b90b","closure.kind":"sha256:eba953afe152ffeeaa76c3c0bfc8bf851b501f991c22827f7bfaa889a6dd3db6","engine":"sha256:cebe806f61b1d0041c31609c62f366917e466031478f753e37ad1353e523b304","format":"sha256:4605679049b01f1f9c2722f9c5b105fbf60c5ad7a6a2488f60d6509544394b4e","graph.edges":"sha256:92b3cfe76eb943303ebf98cccf2e73045d6f562ed3b35fb6f2b031cb60de8944","graph.mentions":"sha256:6dc0105aa8928718fa166269ca88a339c358dc2fb1f9fecb8c139d216fec4ef5","graph.resolutions":"sha256:5ecc3d0e7d5cccb6a804b75ca7105886957a4078d9a298fadf8f0e777ef0202b","kb":"sha256:16f5febbf256d32c60a31e6ab9e41a6bb2c42372e46fde35b2c48ea5b9737938","node:I_AddrOrgNamePostalAddress:A0007":"sha256:f580e97887068368c3e9dadea0ad418e87581f0ba8d3fdc8dc3c83a52606fc14","node:I_AddrOrgNamePostalAddress:A0008":"sha256:6d3aec70d088