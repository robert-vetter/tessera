rc/notifications/footer.html\n@@ -3,5 +3,5 @@\n <footer>\n-  <p>Sent by {{ compny_name }}</p>\n+  <p>Sent by {{ company_name }}</p>\n </footer>"}},{"attributes":[],"kind":"document","name":null,"record":{"id":"PR-198.diff:hunk1","origin":{"ingested_at":"2026-06-10","locator":{"kind":"diff-hunk","parts":[["file","src/payments/db_client.py"],["hunk","1"],["lines","4-7"]]},"source":"devex_synthetic/prs/PR-198.diff"},"text":"diff --git a/src/payments/db_client.py b/src/payments/db_client.py\n@@ -18,7 +18,7 @@ class PaymentsDbClient:\n     def connect(self) -> Connection:\n-        return self._pool.acquire(timeout=10)\n+        return self._pool.acquire(timeout=30)"}},{"attributes":[],"kind":"document","name":null,"record":{"id":"PR-201.diff:hunk1","origin":{"ingested_at":"2026-06-10","locator":{"kind":"diff-hunk","parts":[["file","src/payments/db_client.py"],["hunk","1"],["lines","4-14"]]},"source":"devex_synthetic/prs/PR-201.diff"},"text":"diff --git a/src/payments/db_client.py b/src/payments/db_client.py\n@@ -18,7 +18,13 @@ class PaymentsDbClient:\n     def connect(self) -> Connection:\n-        return self._pool.acquire(timeout=30)\n+        last_error: Exception | None = None\n+        for attempt in range(3):\n+            try:\n+                return self._pool.acquire(timeout=30)\n+            except TimeoutError as error:\n+                last_error = error\n+                sleep(2**attempt)\n+        raise last_error"}},{"attributes":[],"kind":"document","name":null,"record":{"id":"PR-201.diff:hunk2","origin":{"ingested_at":"2026-06-10","locator":{"kind":"diff-hunk","parts":[["file","src/payments/db_client.py"],["hunk","2"],["lines","18-21"]]},"source":"devex_synthetic/prs/PR-201.diff"},"text":"diff --git a/src/payments/db_client.py b/src/payments/db_client.py\n@@ -44,4 +50,5 @@ class PaymentsDbClient:\n     def close(self) -> None:\n+        self._retry_metrics.flush()\n         self._pool.release_all()"}},{"attributes":[],"kind":"document","name":null,"re