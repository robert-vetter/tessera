ubtotal)\n+\n+def _discount_band(count: int) -> Band | None:\n+    return BANDS.get_band(count) if count >= 3 else None"},{"id":"PR-188.diff:hunk2","origin":{"ingested_at":"2026-06-10","locator":{"kind":"diff-hunk","parts":[["file","tests/checkout/test_totals.py"],["hunk","2"],["lines","17-23"]]},"source":"devex_synthetic/prs/PR-188.diff"},"text":"diff --git a/tests/checkout/test_totals.py b/tests/checkout/test_totals.py\n@@ -12,6 +12,12 @@ def test_basket_total_plain():\n     assert basket_total(two_items()).amount == 3998\n+\n+def test_basket_total_discounted():\n+    items = three_items()\n+    total = basket_total(items)\n+    assert total.amount < undiscounted(items).amount"},{"id":"PR-190.diff:hunk1","origin":{"ingested_at":"2026-06-10","locator":{"kind":"diff-hunk","parts":[["file","src/notifications/footer.html"],["hunk","1"],["lines","4-8"]]},"source":"devex_synthetic/prs/PR-190.diff"},"text":"diff --git a/src/notifications/footer.html b/src/notifications/footer.html\n@@ -3,5 +3,5 @@\n <footer>\n-  <p>Sent by {{ compny_name }}</p>\n+  <p>Sent by {{ company_name }}</p>\n </footer>"},{"id":"PR-198.diff:hunk1","origin":{"ingested_at":"2026-06-10","locator":{"kind":"diff-hunk","parts":[["file","src/payments/db_client.py"],["hunk","1"],["lines","4-7"]]},"source":"devex_synthetic/prs/PR-198.diff"},"text":"diff --git a/src/payments/db_client.py b/src/payments/db_client.py\n@@ -18,7 +18,7 @@ class PaymentsDbClient:\n     def connect(self) -> Connection:\n-        return self._pool.acquire(timeout=10)\n+        return self._pool.acquire(timeout=30)"},{"id":"PR-201.diff:hunk1","origin":{"ingested_at":"2026-06-10","locator":{"kind":"diff-hunk","parts":[["file","src/payments/db_client.py"],["hunk","1"],["lines","4-14"]]},"source":"devex_synthetic/prs/PR-201.diff"},"text":"diff --git a/src/payments/db_client.py b/src/payments/db_client.py\n@@ -18,7 +18,13 @@ class PaymentsDbClient:\n     def connect(self) -> Connection:\n-        return self._pool.acquire(timeout=30)\n+        last_error: Exception | None = None\n+        for attempt in range(3):\n+            try:\n+                return self._pool.acquire(timeout=30)\n+            except TimeoutError as error:\n+                last_error = error\n+                sleep(2**attempt)\n+        raise last_error"},{"id":"PR-201.diff:hunk2","origin":{"ingested_at":"2026-06-10","locator":{"kind":"diff-hunk","parts":[["file","src/payments/db_client.py"],["hunk","2"],["lines","18-21"]]},"source":"devex_synthetic/prs/PR-201.diff"},"text":"diff --git a/src/payments/db_client.py b/src/payments/db_client.py\n@@ -44,4 +50,5 @@ class PaymentsDbClient:\n     def close(self) -> None:\n+        self._retry_metrics.flush()\n         self._pool.release_all()"},{"id":"PR-201.diff:hunk3","origin":{"ingested_at":"2026-06-10","locator":{"kind":"diff-hunk","parts":[["file","tests/payments/test_db_client.py"],["hunk","3"],["lines","25-32"]]},"source":"devex_synthetic/prs/PR-201.diff"},"text":"diff --git a/tests/payments/test_db_client.py b/tests/payments/test_db_client.py\n@@ -30,3 +30,10 @@ def test_connect_happy_path():\n     assert client.connect() is not None\n+\n+def test_connect_retries_on_timeout():\n+    pool = FlakyPool(failures=2)\n+    client = PaymentsDbClient(pool)\n+    assert client.connect() is not None\n+    assert pool.acquire_calls == 3"},{"id":"PR-205.diff:hunk1","origin":{"ingested_at":"2026-06-10","locator":{"kind":"diff-hunk","parts":[["file","src/search/indexes.py"],["hunk","1"],["lines","4-8"]]},"source":"devex_synthetic/prs/PR-205.diff"},"text":"diff --git a/src/search/indexes.py b/src/search/indexes.py\n@@ -7,8 +7,8 @@\n-PRIMARY_ALIAS = \"idx-main\"\n-REPLICA_ALIAS = \"idx-shadow\"\n+PRIMARY_ALIAS = \"search-primary\"\n+REPLICA_ALIAS = \"search-replica\""}]},"kind":"full-graph-snapshot"},"format":{"major":1,"minor":0,"name":"tessera-trust-bundle"},"integrity":{"canonicalization":"tessera-canonical-json-1","leaves":{"action":"sha256:74234e98afe7498fb5daf1f36ac2d78acc339464f950