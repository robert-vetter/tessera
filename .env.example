# Tessera — cloud-mode credentials template. COPY to .env (gitignored) and fill in.
#
# The default clone-and-run needs NONE of these: with no variables set, the
# engine runs offline on the deterministic lexical path. These enable the
# recorded "ran on SAP" semantic-retrieval path (ADR 0015; docs/DEPLOYMENT.md).
# Load before a cloud-mode run:  set -a; source .env; set +a

# --- Semantic retrieval mode -------------------------------------------------
# none (default, lexical) | hana (in-DB VECTOR_EMBEDDING — the recorded path)
# | genai-hub (the documented alternative)
TESSERA_EMBEDDINGS=hana

# --- SAP HANA Cloud (vector engine; the NLP feature must be enabled) ---------
HANA_HOST=your-instance.hna1.prod-xx00.hanacloud.ondemand.com
HANA_PORT=443
HANA_USER=TESSERA_APP
HANA_PASSWORD=replace-with-app-user-password
HANA_DATABASE=TESSERA
HANA_EMBEDDING_MODEL=SAP_NEB.20240715

# --- SAP Generative AI Hub embeddings (ALTERNATIVE path; leave unset for HANA)
# TESSERA_GENAI_EMBEDDING_DEPLOYMENT=
# AICORE_AUTH_URL=
# AICORE_CLIENT_ID=
# AICORE_CLIENT_SECRET=
# AICORE_BASE_URL=
# AICORE_RESOURCE_GROUP=default

# --- Optional narration (ADR 0013); unrelated to retrieval -------------------
# TESSERA_NARRATOR=none
